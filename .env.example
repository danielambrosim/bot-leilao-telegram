# Copie para .env e preencha. Nunca commite o .env.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres local: docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://sbl:sbl_dev@127.0.0.1:5432/sbl

# Token do @BotFather
TELEGRAM_TOKEN=

# polling (desenvolvimento) | webhook (produção)
BOT_MODE=polling
# Somente para webhook:
# PUBLIC_URL=https://bot.seudominio.com.br
# TELEGRAM_WEBHOOK_SECRET=  (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")

# Opcional: seu chat_id (descubra com @userinfobot)
# SUPERADMIN_CHAT_ID=

# Produção (docker-compose.yml)
# DOMAIN=bot.seudominio.com.br
# POSTGRES_PASSWORD=

# Fase 2 — segredos (gere valores próprios):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=
DOCS_DIR=./data/docs
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   GUARDE ESTA CHAVE: sem ela os documentos não podem ser lidos.
DOCS_ENCRYPTION_KEY=

# E-mail (obrigatório em produção; em dev, sem SMTP o código aparece no console)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="SBL <nao-responda@seudominio.com.br>"

# Coleta do Jornal Imprensa Leilões
SCRAPER_ENABLED=false
SCRAPER_INTERVAL_HOURS=12

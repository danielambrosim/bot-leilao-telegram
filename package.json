{
  "name": "sbl",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Habilitação digital de arrematantes para leiloeiros via Telegram (B2B, bot compartilhado).",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "webhook:set": "tsx src/scripts/setWebhook.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coletar:imprensa": "tsx src/scripts/coletarImprensa.ts",
    "exportar:habilitados": "tsx src/scripts/exportarHabilitados.ts",
    "seed": "tsx src/scripts/seed.ts",
    "operador:criar": "tsx src/scripts/criarOperador.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielambrosim/bot-leilao-telegram.git"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1177.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "grammy": "^1.48.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode-generator": "^2.0.4",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "jsqr": "^1.4.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "yauzl": "^3.4.0"
  }
}
